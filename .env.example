# HTTP Basic Auth gate on /admin/* (middleware.ts). Never commit real values.
ADMIN_USER=
ADMIN_PASS=

# FastAPI backend base URL, no trailing slash (e.g. https://reviewpilot-backend.awsapprunner.com).
BACKEND_URL=http://localhost:8000

# Must match the backend's ADMIN_API_KEY exactly. Server-only (lib/api.ts) — never expose this
# via a NEXT_PUBLIC_* variable, it must never reach the browser bundle.
ADMIN_API_KEY=

# Must match the backend's AUTH_JWT_SECRET exactly (SPRINT_04.md ticket 4.2). Verifies the
# customer session cookie locally (middleware.ts + /app) — server-only, never a NEXT_PUBLIC_*
# variable.
AUTH_JWT_SECRET=
